PORT=127.0.0.1:8888
# IPv6 is supported with bracket notation, e.g. PORT=[::1]:8888 or PORT=[::]:443
# (brackets are stripped internally: [::1]:8888 -> listen ::1, port 8888)
PASSWORD=
XRAY_UUID=5ccad305-e243-4bb2-abf0-1e37189ce4e8
FAKE_SNI=api24-normal-alisg.tiktokv.com#Tiktok,vnpt.theworkpc.com#Free VNPT
WS_PATH=/tiktok4g
WS_HOST=trycloudflare.com
TRANSPORT=websocket,xhttp
XHTTP_MODE=packet-up
ENABLE_WARP=false
WEBHOOK_URL=
# Optional: use a named Cloudflare Tunnel (Zero Trust dashboard) instead of a
# quick/ephemeral tunnel. If set, cloudflared runs as:
#   cloudflared tunnel run --token <TUNNEL_TOKEN>
# The Public Hostname you configured on the dashboard IS your domain, so also
# set WS_HOST to that hostname (e.g. reverse.huskydg.io.vn) — it will be used
# directly instead of scraping a *.trycloudflare.com URL from the logs.
TUNNEL_TOKEN=

# Optional: listen for VLESS directly with TLS (security=tls), without going
# through Cloudflare. Format is the same as PORT (e.g. 0.0.0.0:443), IPv6
# bracket notation supported too (e.g. [::]:8443). Leave empty to disable.
TLS_PORT=
# Path to the private key / full certificate chain to use for TLS_PORT.
# Leave both empty and, if TLS_PORT is set, a self-signed cert/key will be
# generated automatically at ./tls/private.key and ./tls/fullchain.pem,
# using WS_HOST as the certificate's domain (CN/SAN).
TLS_KEY=
TLS_PEM=